---
import Monogram from './Monogram.astro';
import StatusBadge from './StatusBadge.astro';
import Chips from './Chips.astro';
import Icon from './Icon.astro';
import { base, formatDateShort, t, type Lang } from '../i18n/ui';
import { slugOf, type Project, type Release } from '../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
  /** Newest shipped release, when the project has one. */
  latest?: Release;
}

const { project, lang, latest } = Astro.props;
const tr_ = t(lang);
const b = base(lang);
const d = project.data;
const href = `${b}/projects/${slugOf(project.id)}/`;
const style = `--brand-light:${d.accent};--brand-dark:${d.accentDark ?? d.accent};`;

/** A card falls back to the cover art when it has none of its own. */
const art = d.card ?? d.cover;
---

<article
  class="card"
  style={style}
  data-project
  data-status={d.status}
  data-stack={d.stack.join('|')}
>
  <a class="card__hit" href={href} aria-label={d.name}></a>

  {
    art && (
      <div class="card__art">
        <img src={art} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }

  <header class="card__head">
    <Monogram
      monogram={d.monogram}
      accent={d.accent}
      accentDark={d.accentDark}
      glyph={d.glyph}
      icon={d.icon}
    />
    <h3 class="card__name">{d.name}</h3>
    <StatusBadge status={d.status} lang={lang} />
  </header>

  <p class="card__tagline">{d.tagline}</p>

  {
    d.stack.length > 0 && <Chips items={d.stack} limit={4} />
  }

  <footer class="card__foot meta">
    {
      latest ? (
        <span class="card__version">
          <Icon name="releases" size={12} />
          {latest.data.version}
          <span class="card__sep">·</span>
          <time datetime={latest.data.date.toISOString()}>
            {formatDateShort(latest.data.date, lang)}
          </time>
        </span>
      ) : (
        <span class="card__version card__version--none">
          <Icon name="circle" size={12} />
          {tr_('changelog.empty')}
        </span>
      )
    }
    <span class="card__go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
  </footer>
</article>
