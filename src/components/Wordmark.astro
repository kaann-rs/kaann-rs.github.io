---
import Mark from './Mark.astro';

/**
 * The full lockup: the cloud, then `kaan/blog` set in type rather than baked
 * into an image, so it stays crisp at any size and follows the surface.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: klass } = Astro.props;
---

<span class:list={['wordmark', klass]}>
  <Mark size={size} class="wordmark__mark" />
  <span class="wordmark__text">
    <span class="wordmark__name">kaan</span><span class="wordmark__slug">/blog</span>
  </span>
</span>
