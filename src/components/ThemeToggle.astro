---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button class="icon-btn" id="theme-toggle" type="button" aria-label={label} title={label}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="t-sun" d="M12 3v1.5M12 19.5V21M4.2 4.2l1.1 1.1M18.7 18.7l1.1 1.1M3 12h1.5M19.5 12H21M4.2 19.8l1.1-1.1M18.7 5.3l1.1-1.1" />
    <circle class="t-sun" cx="12" cy="12" r="3.6" />
    <path class="t-moon" d="M20 13.4A8 8 0 1 1 10.6 4a6.4 6.4 0 0 0 9.4 9.4Z" />
  </svg>
</button>

<style is:global>
  .t-moon { display: none; }
  html.dark .t-sun { display: none; }
  html.dark .t-moon { display: inline; }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>
