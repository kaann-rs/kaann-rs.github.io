---
import Monogram from './Monogram.astro';
import StatusBadge from './StatusBadge.astro';
import Chips from './Chips.astro';
import Icon from './Icon.astro';
import { formatDateShort, t, type Lang } from '../i18n/ui';
import { slugOf, type Project, type Section } from '../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
  /** Which section is being shown — matched against Section.id. */
  current: string;
  sections: Section[];
}

const { project, lang, current, sections } = Astro.props;
const tr_ = t(lang);
const d = project.data;
const slug = slugOf(project.id);

const links = [
  d.repo && { href: d.repo, label: tr_('project.repo'), icon: 'repo' },
  d.homepage && { href: d.homepage, label: tr_('project.homepage'), icon: 'globe' },
].filter((l): l is { href: string; label: string; icon: string } => Boolean(l));
---

<header class="project-head">
  {
    d.cover && (
      <div class="project-cover band">
        <img src={d.cover} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="project-head__id">
    <Monogram
      monogram={d.monogram}
      accent={d.accent}
      accentDark={d.accentDark}
      glyph={d.glyph}
      icon={d.icon}
      size="lg"
    />
    <div class="project-head__names">
      <div class="project-head__title">
        <h1>{d.name}</h1>
        <StatusBadge status={d.status} lang={lang} />
      </div>
      <p class="project-head__tagline">{d.tagline}</p>
    </div>
  </div>

  <dl class="project-facts meta band">
    {
      d.license && (
        <div>
          <dt>
            <Icon name="license" size={13} />
            {tr_('project.license')}
          </dt>
          <dd>{d.license}</dd>
        </div>
      )
    }
    {
      d.started && (
        <div>
          <dt>
            <Icon name="calendar" size={13} />
            {tr_('project.started')}
          </dt>
          <dd>
            <time datetime={d.started.toISOString()}>{formatDateShort(d.started, lang)}</time>
          </dd>
        </div>
      )
    }
    {
      links.length > 0 && (
        <div>
          <dt>
            <Icon name="external" size={13} />
            {tr_('project.links')}
          </dt>
          <dd class="project-facts__links">
            {links.map((l) => (
              <a href={l.href} rel="noopener">
                <Icon name={l.icon} size={13} />
                {l.label}
              </a>
            ))}
          </dd>
        </div>
      )
    }
  </dl>

  {
    d.stack.length > 0 && <Chips items={d.stack} class="project-head__stack" />
  }

  {
    sections.length > 1 && (
      <nav class="tabs band" aria-label={tr_('a11y.projectNav')} data-project={slug}>
        {sections.map((s) => (
          <a href={s.href} aria-current={s.id === current ? 'page' : undefined}>
            <Icon name={s.icon} size={14} />
            {s.label}
          </a>
        ))}
      </nav>
    )
  }
</header>
