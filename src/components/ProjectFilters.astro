---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import type { Project } from '../lib/projects';

/**
 * Filters the project grid in the browser. Two groups — lifecycle and stack —
 * that combine with AND. With no JavaScript the bar simply is not there and
 * every project stays visible, which is the honest fallback for a static site.
 */
interface Props {
  projects: Project[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const tr_ = t(lang);

const statuses = [...new Set(projects.map((p) => p.data.status))];
const stacks = [...new Set(projects.flatMap((p) => p.data.stack))].sort((a, b) =>
  a.localeCompare(b)
);
const hasFilters = statuses.length > 1 || stacks.length > 1;
---

{
  hasFilters && (
    <div class="filters band" data-rule="bottom" data-filters hidden>
      <div class="filters__group">
        <span class="filters__label meta">
          <Icon name="target" size={13} />
          {tr_('filters.status')}
        </span>
        <div class="filters__set" role="group">
          <button class="pill" type="button" data-filter="status" data-value="" aria-pressed="true">
            {tr_('filters.all')}
          </button>
          {statuses.map((status) => (
            <button class="pill" type="button" data-filter="status" data-value={status} aria-pressed="false">
              <span class="pill__dot" data-status={status} />
              {tr_(`status.${status}`)}
            </button>
          ))}
        </div>
      </div>

      {stacks.length > 1 && (
        <div class="filters__group">
          <span class="filters__label meta">
            <Icon name="package" size={13} />
            {tr_('filters.stack')}
          </span>
          <div class="filters__set" role="group">
            <button class="pill" type="button" data-filter="stack" data-value="" aria-pressed="true">
              {tr_('filters.all')}
            </button>
            {stacks.map((item) => (
              <button class="pill" type="button" data-filter="stack" data-value={item} aria-pressed="false">
                <Icon name={item} size={12} />
                {item}
              </button>
            ))}
          </div>
        </div>
      )}

      <p class="filters__count meta" data-filter-count data-template={tr_('filters.showing')} hidden />
    </div>
  )
}

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');

  if (bar && grid) {
    // Only reveal the controls once they can actually do something.
    bar.hidden = false;

    const cards = [...grid.querySelectorAll<HTMLElement>('[data-project]')];
    const count = bar.querySelector<HTMLElement>('[data-filter-count]');
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const active: Record<string, string> = { status: '', stack: '' };

    const matches = (card: HTMLElement) =>
      (!active.status || card.dataset.status === active.status) &&
      (!active.stack || (card.dataset.stack ?? '').split('|').includes(active.stack));

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const ok = matches(card);
        card.hidden = !ok;
        if (ok) shown++;
      }
      if (count) {
        const filtered = Boolean(active.status || active.stack);
        count.hidden = !filtered;
        count.textContent = count.dataset.template!.replace('{n}', String(shown));
      }
      if (empty) empty.hidden = shown > 0;
    };

    for (const button of bar.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
      button.addEventListener('click', () => {
        const group = button.dataset.filter!;
        active[group] = button.dataset.value!;
        for (const sibling of bar.querySelectorAll<HTMLButtonElement>(`[data-filter="${group}"]`)) {
          sibling.setAttribute('aria-pressed', String(sibling === button));
        }
        apply();
      });
    }
  }
</script>
