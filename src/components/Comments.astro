---
import { GISCUS } from '../consts.js';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr_ = t(lang);

// Render nothing when unconfigured — better than a half-working component.
const ready = GISCUS.enabled && GISCUS.repoId && GISCUS.categoryId;
---

{
  ready && (
    <section class="comments" aria-labelledby="comments-heading">
      <p class="section-label" id="comments-heading">{tr_('post.comments')}</p>

      <div class="comments__mount">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping={GISCUS.mapping}
          data-strict="1"
          data-reactions-enabled={GISCUS.reactionsEnabled}
          data-emit-metadata="0"
          data-input-position={GISCUS.inputPosition}
          data-theme={GISCUS.themes.light}
          data-lang={lang}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </div>
    </section>
  )
}

{
  ready && (
    <script is:inline define:vars={{ themes: GISCUS.themes }}>
      (function () {
        var frame = null;

        function current() {
          return document.documentElement.classList.contains('dark')
            ? themes.dark
            : themes.light;
        }

        function push() {
          frame =
            frame ||
            document.querySelector('iframe.giscus-frame');
          if (!frame) return;
          frame.contentWindow.postMessage(
            { giscus: { setConfig: { theme: current() } } },
            'https://giscus.app'
          );
        }

        // giscus loads its iframe late and tells us once it is ready.
        window.addEventListener('message', function (e) {
          if (e.origin === 'https://giscus.app' && e.data && e.data.giscus) push();
        });

        // Notify the iframe when the theme or light/dark mode changes.
        new MutationObserver(push).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-theme'],
        });
      })();
    </script>
  )
}
