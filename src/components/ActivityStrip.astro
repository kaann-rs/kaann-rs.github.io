---
import { t, type Lang } from '../i18n/ui';
import type { Activity } from '../lib/projects';

/**
 * Twelve months of shipping, one cell each.
 *
 * The cells are always drawn — a quiet month is information too, and an empty
 * strip is an honest answer to "is this alive?".
 */
interface Props {
  items: Activity[];
  lang: Lang;
  months?: number;
  /** Today, passed in so the component stays pure and the build stays stable. */
  now?: Date;
}

const { items, lang, months = 12, now = new Date() } = Astro.props;
const tr_ = t(lang);

const key = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;

const counts = new Map<string, number>();
for (const { release } of items) {
  const k = key(release.data.date);
  counts.set(k, (counts.get(k) ?? 0) + 1);
}

const monthName = new Intl.DateTimeFormat(lang === 'tr' ? 'tr-TR' : 'en-GB', { month: 'short' });
const monthLong = new Intl.DateTimeFormat(lang === 'tr' ? 'tr-TR' : 'en-GB', {
  month: 'long',
  year: 'numeric',
});

const cells = Array.from({ length: months }, (_, i) => {
  const d = new Date(now.getFullYear(), now.getMonth() - (months - 1 - i), 1);
  const count = counts.get(key(d)) ?? 0;
  return {
    label: monthName.format(d),
    full: monthLong.format(d),
    count,
    /** Four steps is enough to read a rhythm without pretending to be a chart. */
    level: count === 0 ? 0 : count === 1 ? 1 : count <= 3 ? 2 : count <= 6 ? 3 : 4,
    isYearStart: d.getMonth() === 0,
  };
});

const total = cells.reduce((sum, c) => sum + c.count, 0);
---

<section class="strip band" data-rule="top" aria-labelledby="activity-strip">
  <div class="section__head">
    <h2 class="section__label" id="activity-strip">{tr_('strip.title')}</h2>
    <span class="section__more meta">
      {
        lang === 'tr'
          ? `${months} ayda ${total} sürüm`
          : `${total} ${tr_('strip.inMonths').replace('{n}', String(months))}`
      }
    </span>
  </div>

  <ol class="strip__cells">
    {
      cells.map((cell) => (
        <li
          class="strip__cell"
          data-level={cell.level}
          data-year-start={cell.isYearStart ? '' : undefined}
        >
          <span class="strip__bar" title={`${cell.full}: ${cell.count}`} />
          <span class="strip__month meta">{cell.label}</span>
        </li>
      ))
    }
  </ol>
</section>
