---
import Base from '../../layouts/Base.astro';
import ActivityFeed from '../ActivityFeed.astro';
import Empty from '../Empty.astro';
import Icon from '../Icon.astro';
import { getActivity } from '../../lib/projects';
import { t, base, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr_ = t(lang);
const b = base(lang);

const activity = await getActivity(lang);

/** Grouped by year — a long ledger is easier to scan with anchors in it. */
const byYear = new Map<number, typeof activity>();
for (const a of activity) {
  const y = a.release.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), a]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base
  lang={lang}
  title={tr_('changelog.all')}
  description={tr_('changelog.allLede')}
  path={`${b}/changelog/`}
  altPath={lang === 'en' ? '/tr/changelog/' : '/changelog/'}
>
  <div class="wrap">
    <header class="page-head band" data-rule="bottom">
      <h1>{tr_('changelog.all')}</h1>
      <p class="lede">{tr_('changelog.allLede')}</p>
      <p class="page-head__count meta">
        <a href={`${b}/changelog/rss.xml`}>
          <Icon name="rss" size={13} />
          {tr_('changelog.subscribe')}
        </a>
      </p>
    </header>

    {
      years.length === 0 ? (
        <Empty text={tr_('changelog.empty')} />
      ) : (
        years.map((year) => (
          <section class="section band" data-rule="top">
            <div class="section__head">
              <h2 class="section__label">{year}</h2>
            </div>
            <ActivityFeed items={byYear.get(year)!} lang={lang} />
          </section>
        ))
      )
    }
  </div>
</Base>
