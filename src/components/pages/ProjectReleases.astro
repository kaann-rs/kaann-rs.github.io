---
import Base from '../../layouts/Base.astro';
import ProjectHeader from '../ProjectHeader.astro';
import Empty from '../Empty.astro';
import Icon from '../Icon.astro';
import { projectNav, slugOf, hasTranslation, type Project } from '../../lib/projects';
import { t, base, formatDateShort, type Lang } from '../../i18n/ui';

/** The compact ledger: one row per version, linking into the changelog entry. */
interface Props { project: Project }

const { project } = Astro.props;
const lang = project.data.lang;
const tr_ = t(lang);
const slug = slugOf(project.id);
const other: Lang = lang === 'en' ? 'tr' : 'en';

const { releases, sections } = await projectNav(lang, slug);
const changelogHref = `${base(lang)}/projects/${slug}/changelog/`;

const altPath = (await hasTranslation(lang, slug))
  ? `${base(other)}/projects/${slug}/releases/`
  : undefined;
---

<Base
  lang={lang}
  title={`${project.data.name} — ${tr_('section.releases')}`}
  description={tr_('releases.lede')}
  path={`${base(lang)}/projects/${slug}/releases/`}
  altPath={altPath}
  accent={project.data.accent}
  accentDark={project.data.accentDark}
  ogImage={`/og/${lang === 'en' ? '' : 'tr/'}${slug}.png`}
>
  <div class="wrap">
    <article>
      <ProjectHeader project={project} lang={lang} current="releases" sections={sections} />

      <div class="doc-head band" data-rule="bottom">
        <h2 class="doc-head__title">
          <Icon name="releases" size={18} />
          {tr_('section.releases')}
        </h2>
        <p class="doc-head__desc">{tr_('releases.lede')}</p>
      </div>

      {
        releases.length === 0 ? (
          <Empty text={tr_('changelog.empty')} />
        ) : (
          <ul class="ledger band">
            {releases.map((r) => (
              <li class="ledger__row" data-unreleased={r.data.unreleased ? '' : undefined}>
                <a class="ledger__link" href={`${changelogHref}#v${r.data.version}`}>
                  <span class="ledger__version">
                    {r.data.unreleased ? tr_('changelog.unreleased') : r.data.version}
                  </span>
                  <span class="kind meta">
                    <Icon name={r.data.unreleased ? 'hammer' : 'releases'} size={11} />
                    {tr_(`kind.${r.data.kind}`)}
                  </span>
                  <span class="ledger__summary">{r.data.summary}</span>
                  <time class="ledger__date meta" datetime={r.data.date.toISOString()}>
                    {formatDateShort(r.data.date, lang)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </article>
  </div>
</Base>
