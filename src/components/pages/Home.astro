---
import Base from '../../layouts/Base.astro';
import PostCard from '../PostCard.astro';
import PixelIcon from '../PixelIcon.astro';
import PostList from '../PostList.astro';
import Tag from '../Tag.astro';
import Empty from '../Empty.astro';
import Icon from '../Icon.astro';
import { getPosts, getTags } from '../../lib/posts';
import { HOME_POSTS } from '../../consts.js';
import { t, base, formatDateShort, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr_ = t(lang);
const b = base(lang);

const posts = await getPosts(lang);
const tags = await getTags(lang);

/* The lead: whatever is marked featured, or simply the newest two. The rest
   fall into the list below, so nothing is shown twice — and the list only
   appears when it has something the cards did not already show. */
const marked = posts.filter((p) => p.data.featured);
const lead = (marked.length > 0 ? marked : posts).slice(0, 2);
const leadIds = new Set(lead.map((p) => p.id));
const rest = posts.filter((p) => !leadIds.has(p.id)).slice(0, HOME_POSTS);

/* Two sections, never the same heading twice: the cards are "Featured" only
   when something was actually marked, and the list underneath is whatever
   comes after them. */
const leadLabel = marked.length > 0 ? tr_('home.featured') : tr_('home.recent');
const restLabel = marked.length > 0 ? tr_('home.recent') : tr_('home.earlier');

/* A three-cell ledger under the hero: how much there is, across how many
   subjects, and whether any of it is recent. */
const stats = [
  { icon: 'markdown', label: tr_('home.statPosts'), value: String(posts.length) },
  { icon: 'target', label: tr_('home.statTags'), value: String(tags.length) },
  {
    icon: 'clock',
    label: tr_('home.statLatest'),
    value: posts[0] ? formatDateShort(posts[0].data.date, lang) : tr_('home.statNone'),
  },
];
---

<Base
  lang={lang}
  title={tr_('home.title')}
  description={tr_('site.tagline')}
  path={`${b}/`}
  altPath={lang === 'en' ? '/tr/' : '/'}
>
  <div class="wrap">
    <section class="hero hero--art band" data-rule="bottom">
      <div class="hero__text">
        <h1>{tr_('home.title')}</h1>
        <p class="lede">{tr_('home.lede')}</p>
      </div>

      {/* The two marks the kit draws at full size — a scene rather than an
          icon, so the home page carries the brand without a photograph. */}
      <div class="hero__art" aria-hidden="true">
        <PixelIcon name="bulut" size={104} class="hero__art-cloud" />
        <PixelIcon name="yengec-rust" size={76} class="hero__art-crab" />
      </div>
    </section>

    <dl class="stats band" data-rule="top">
      {
        stats.map((stat) => (
          <div class="stats__cell">
            <dt class="meta">
              <Icon name={stat.icon} size={13} />
              {stat.label}
            </dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      lead.length > 0 && (
        <section class="section band" data-rule="top" aria-labelledby="home-lead">
          <div class="section__head">
            <h2 class="section__label" id="home-lead">{leadLabel}</h2>
            {rest.length === 0 && posts.length > lead.length && (
              <a class="section__more meta" href={`${b}/posts/`}>
                {tr_('home.allPosts')} →
              </a>
            )}
          </div>

          <div class="grid band">
            {lead.map((post) => (
              <PostCard post={post} lang={lang} />
            ))}
          </div>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section class="section band" data-rule="top" aria-labelledby="home-rest">
          <div class="section__head">
            <h2 class="section__label" id="home-rest">{restLabel}</h2>
            {posts.length > lead.length + rest.length && (
              <a class="section__more meta" href={`${b}/posts/`}>
                {tr_('home.allPosts')} →
              </a>
            )}
          </div>

          <PostList posts={rest} lang={lang} />
        </section>
      )
    }

    {
      posts.length === 0 && (
        <div class="section band" data-rule="top">
          <Empty text={tr_('posts.empty')} icon="markdown" />
        </div>
      )
    }

    {
      tags.length > 0 && (
        <section class="section band" data-rule="top" aria-labelledby="home-tags">
          <div class="section__head">
            <h2 class="section__label" id="home-tags">{tr_('home.browseTags')}</h2>
            <a class="section__more meta" href={`${b}/tags/`}>{tr_('tags.all')} →</a>
          </div>

          <ul class="tag-list">
            {tags.slice(0, 12).map(({ tag, count }) => (
              <li>
                <Tag tag={tag} href={`${b}/tags/${tag}/`} count={count} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
