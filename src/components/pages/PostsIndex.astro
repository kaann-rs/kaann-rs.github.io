---
import Base from '../../layouts/Base.astro';
import PostList from '../PostList.astro';
import { getPosts } from '../../lib/posts';
import { t, base, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr_ = t(lang);
const b = base(lang);

const posts = await getPosts(lang);

/** Group by year — makes a long list easier to scan. */
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base
  lang={lang}
  title={tr_('posts.all')}
  path={`${b}/posts/`}
  altPath={lang === 'en' ? '/tr/posts/' : '/posts/'}
>
  <div class="wrap">
    <section class="intro">
      <h1>{tr_('posts.all')}</h1>
    </section>

    {
      years.length === 0 ? (
        <p class="meta" style="margin-top:2rem">{tr_('posts.empty')}</p>
      ) : (
        years.map((year) => (
          <>
            <h2 class="section-label">{year}</h2>
            <PostList posts={byYear.get(year)!} lang={lang} />
          </>
        ))
      )
    }
  </div>
</Base>
