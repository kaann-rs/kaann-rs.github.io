---
import { getEntry, render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import Sources from '../Sources.astro';
import { t, base, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr_ = t(lang);
const b = base(lang);

const entry = await getEntry('pages', `${lang}/about`);
if (!entry) throw new Error(`Missing content: src/content/pages/${lang}/about.md`);

const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  path={`${b}/about/`}
  altPath={lang === 'en' ? '/tr/about/' : '/about/'}
>
  <div class="wrap">
    <article>
      <header class="page-head band" data-rule="bottom">
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="lede">{entry.data.description}</p>}
      </header>

      <div class="prose">
        <Content />
      </div>

      <Sources sources={entry.data.sources} label={tr_('project.sources')} />
    </article>
  </div>
</Base>
