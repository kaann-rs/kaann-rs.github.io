---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectFilters from '../ProjectFilters.astro';
import Empty from '../Empty.astro';
import { getProjects, latestRelease, slugOf } from '../../lib/projects';
import { t, base, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr_ = t(lang);
const b = base(lang);

const projects = await getProjects(lang);
const cards = await Promise.all(
  projects.map(async (project) => ({
    project,
    latest: await latestRelease(lang, slugOf(project.id)),
  }))
);
---

<Base
  lang={lang}
  title={tr_('projects.all')}
  path={`${b}/projects/`}
  altPath={lang === 'en' ? '/tr/projects/' : '/projects/'}
>
  <div class="wrap">
    <header class="page-head band" data-rule="bottom">
      <h1>{tr_('projects.all')}</h1>
      <p class="page-head__count meta">{projects.length} {tr_('projects.count')}</p>
    </header>

    <ProjectFilters projects={projects} lang={lang} />

    {
      cards.length === 0 ? (
        <Empty text={tr_('projects.empty')} icon="package" />
      ) : (
        <>
          <div class="grid band" data-project-grid>
            {cards.map(({ project, latest }) => (
              <ProjectCard project={project} lang={lang} latest={latest} />
            ))}
          </div>
          <div data-filter-empty hidden>
            <Empty text={tr_('filters.none')} icon="search" />
          </div>
        </>
      )
    }
  </div>
</Base>
