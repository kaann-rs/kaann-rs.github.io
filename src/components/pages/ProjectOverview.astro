---
import { render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import ProjectHeader from '../ProjectHeader.astro';
import Sources from '../Sources.astro';
import TOC from '../TOC.astro';
import { projectNav, slugOf, hasTranslation, type Project } from '../../lib/projects';
import { t, base, type Lang } from '../../i18n/ui';

interface Props { project: Project }

const { project } = Astro.props;
const lang = project.data.lang;
const tr_ = t(lang);
const slug = slugOf(project.id);
const other: Lang = lang === 'en' ? 'tr' : 'en';

const { sections } = await projectNav(lang, slug);
const { Content, headings } = await render(project);

const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const showToc = tocItems.length >= 2;

const altPath = (await hasTranslation(lang, slug))
  ? `${base(other)}/projects/${slug}/`
  : undefined;
---

<Base
  lang={lang}
  title={project.data.name}
  description={project.data.description ?? project.data.tagline}
  path={`${base(lang)}/projects/${slug}/`}
  altPath={altPath}
  accent={project.data.accent}
  accentDark={project.data.accentDark}
  ogImage={`/og/${lang === 'en' ? '' : 'tr/'}${slug}.png`}
>
  <div class="wrap">
    <ProjectHeader project={project} lang={lang} current="overview" sections={sections} />

    <div class="doc-grid band">
      <article>
        {
          showToc && (
            <details class="toc-inline">
              <summary>{tr_('project.contents')}</summary>
              <TOC headings={headings} label={tr_('project.contents')} />
            </details>
          )
        }

        <div class="prose">
          <Content />
        </div>

        <Sources sources={project.data.sources} label={tr_('project.sources')} />
      </article>

      {
        showToc && (
          <aside class="toc-aside">
            <div class="toc-aside__sticky">
              <TOC headings={headings} label={tr_('project.contents')} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</Base>
