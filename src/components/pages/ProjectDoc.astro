---
import { render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import ProjectHeader from '../ProjectHeader.astro';
import Sources from '../Sources.astro';
import Icon from '../Icon.astro';
import TOC from '../TOC.astro';
import { projectNav, slugOf, sectionOf, hasTranslation, type Project, type Doc } from '../../lib/projects';
import { t, base, type Lang } from '../../i18n/ui';

/** Any file-backed section: readme, architecture, structure, state, or a custom one. */
interface Props {
  project: Project;
  doc: Doc;
}

const { project, doc } = Astro.props;
const lang = project.data.lang;
const tr_ = t(lang);
const slug = slugOf(project.id);
const section = sectionOf(doc.id);
const other: Lang = lang === 'en' ? 'tr' : 'en';

const { sections } = await projectNav(lang, slug);
const entry = sections.find((s) => s.id === section);
const label = entry?.label ?? section;
const glyph = entry?.icon ?? '';

const { Content, headings } = await render(doc);
const showToc = headings.filter((h) => h.depth >= 2 && h.depth <= 4).length >= 2;

const altPath = (await hasTranslation(lang, slug))
  ? `${base(other)}/projects/${slug}/${section}/`
  : undefined;
---

<Base
  lang={lang}
  title={`${project.data.name} — ${label}`}
  description={doc.data.description ?? `${label}: ${project.data.tagline}`}
  path={`${base(lang)}/projects/${slug}/${section}/`}
  altPath={altPath}
  accent={project.data.accent}
  accentDark={project.data.accentDark}
  ogImage={`/og/${lang === 'en' ? '' : 'tr/'}${slug}.png`}
>
  <div class="wrap">
    <ProjectHeader project={project} lang={lang} current={section} sections={sections} />

    <div class="doc-head band" data-rule="bottom">
      <h2 class="doc-head__title">
        <Icon name={glyph} size={18} />
        {label}
      </h2>
      {doc.data.description && <p class="doc-head__desc">{doc.data.description}</p>}
    </div>

    <div class="doc-grid band">
      <article>
        {
          showToc && (
            <details class="toc-inline">
              <summary>{tr_('project.contents')}</summary>
              <TOC headings={headings} label={tr_('project.contents')} />
            </details>
          )
        }

        <div class="prose">
          <Content />
        </div>

        <Sources sources={doc.data.sources} label={tr_('project.sources')} />
      </article>

      {
        showToc && (
          <aside class="toc-aside">
            <div class="toc-aside__sticky">
              <TOC headings={headings} label={tr_('project.contents')} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</Base>
