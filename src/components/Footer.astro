---
import { SITE } from '../consts.js';
import { t, base, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr_ = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner meta">
    <span>© {year} {SITE.author}</span>
    <span>
      <a href={`${base(lang)}/rss.xml`}>RSS</a>
      {' · '}
      <a href={SITE.github}>{tr_('footer.source')}</a>
    </span>
  </div>
</footer>
