---
import { t, type Lang } from '../i18n/ui';
import type { STATUSES } from '../consts.js';

interface Props {
  status: (typeof STATUSES)[number];
  lang: Lang;
}

const { status, lang } = Astro.props;
const tr_ = t(lang);
---

<span class="status" data-status={status}>
  <span class="status__dot"></span>
  {tr_(`status.${status}`)}
</span>
