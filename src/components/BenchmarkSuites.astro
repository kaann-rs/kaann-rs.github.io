---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import type { Benchmark } from '../lib/projects';

/**
 * Measured comparisons, drawn as bars against the slowest entry in each suite.
 *
 * The bar length is always the raw ratio, so a short bar means a small number
 * whichever direction is better; the winner is marked instead of implied.
 */
interface Props {
  benchmark: Benchmark;
  lang: Lang;
}

const { benchmark, lang } = Astro.props;
const tr_ = t(lang);
const { environment, suites } = benchmark.data;

const facts = [
  { icon: 'cpu', label: tr_('bench.machine'), value: environment.machine },
  { icon: 'terminal', label: tr_('bench.os'), value: environment.os },
  { icon: 'package', label: tr_('bench.toolchain'), value: environment.toolchain },
  { icon: 'markup', label: tr_('bench.input'), value: environment.input },
].filter((f): f is { icon: string; label: string; value: string } => Boolean(f.value));

/** Formats without inventing precision the source did not have. */
const num = new Intl.NumberFormat(lang === 'tr' ? 'tr-TR' : 'en-GB', {
  maximumFractionDigits: 2,
});
---

<section class="bench-env band" data-rule="bottom" aria-label={tr_('bench.environment')}>
  <dl class="bench-env__grid meta">
    {
      facts.map((f) => (
        <div>
          <dt>
            <Icon name={f.icon} size={13} />
            {f.label}
          </dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>
  <p class="bench-env__method meta">
    <Icon name="target" size={13} />
    <span>{environment.method}</span>
  </p>
</section>

<ol class="suites">
  {
    suites.map((suite) => {
      const values = suite.results.map((r) => r.value);
      const best = suite.lowerIsBetter ? Math.min(...values) : Math.max(...values);
      const scale = Math.max(...values) || 1;

      return (
        <li class="suite band" data-rule="top">
          <header class="suite__head">
            <h3 class="suite__title">{suite.title}</h3>
            <span class="suite__unit meta">
              {suite.unit} · {suite.lowerIsBetter ? tr_('bench.lower') : tr_('bench.higher')}
            </span>
          </header>

          {suite.note && <p class="suite__note meta">{suite.note}</p>}

          <ul class="bars">
            {suite.results.map((r) => (
              <li class="bar" data-best={r.value === best ? '' : undefined} data-mine={r.mine ? '' : undefined}>
                <span class="bar__label">
                  {r.label}
                  {r.mine && <span class="bar__tag meta">{tr_('bench.mine')}</span>}
                </span>
                <span class="bar__track" aria-hidden="true">
                  <span class="bar__fill" style={`--pct:${(r.value / scale) * 100}%`} />
                </span>
                <span class="bar__value meta">
                  {num.format(r.value)}
                  <span class="bar__unit">{suite.unit}</span>
                </span>
                {r.note && <span class="bar__note meta">{r.note}</span>}
              </li>
            ))}
          </ul>
        </li>
      );
    })
  }
</ol>
