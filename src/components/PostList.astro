---
import type { CollectionEntry } from 'astro:content';
import { base, slugOf, formatDate, t, type Lang } from '../i18n/ui';

interface Props {
  posts: CollectionEntry<'posts'>[];
  lang: Lang;
  /** Hide descriptions — useful for the short list on the home page. */
  compact?: boolean;
}

const { posts, lang, compact = false } = Astro.props;
const tr_ = t(lang);
const b = base(lang);
---

{
  posts.length === 0 ? (
    <p class="meta">{tr_('posts.empty')}</p>
  ) : (
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a class="post-item" href={`${b}/posts/${slugOf(p.id)}/`}>
            <span class="post-item__title">{p.data.title}</span>
            <time class="post-item__date" datetime={p.data.date.toISOString()}>
              {formatDate(p.data.date, lang)}
            </time>
            {!compact && <p class="post-item__desc">{p.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  )
}
