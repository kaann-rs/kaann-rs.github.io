---
/*
 * Mermaid diagrams — lazily loaded.
 *
 * If the page has no `.mermaid-graph`, the mermaid package is never fetched;
 * Vite splits it into its own chunk and the dynamic import fires on demand.
 */
---

<script>
  const nodes = document.querySelectorAll<HTMLElement>('[data-mermaid]');

  if (nodes.length) {
    const scheme = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => scheme.matches;

    /*
     * Bind site tokens to mermaid's theme variables.
     *
     * Some tokens live on <body> and some are color-mix() expressions, which
     * mermaid cannot parse. Resolving each one through a throwaway element
     * hands it a plain rgb() value whatever the token was written as.
     */
    const probe = document.createElement('span');
    probe.style.display = 'none';
    document.body.appendChild(probe);

    // color-mix() computes to `color(srgb …)`, a format mermaid rejects, so
    // anything in that shape is converted back to plain rgb().
    const SRGB = /^color\(srgb\s+([\d.eE+-]+)\s+([\d.eE+-]+)\s+([\d.eE+-]+)(?:\s*\/\s*([\d.eE+-]+))?\s*\)$/;

    const toRgb = (value: string) => {
      const m = SRGB.exec(value);
      if (!m) return value;
      const ch = (x: string) => Math.max(0, Math.min(255, Math.round(parseFloat(x) * 255)));
      const alpha = m[4] === undefined ? 1 : parseFloat(m[4]);
      const rgb = `${ch(m[1])}, ${ch(m[2])}, ${ch(m[3])}`;
      return alpha >= 1 ? `rgb(${rgb})` : `rgba(${rgb}, ${alpha})`;
    };

    const color = (name: string) => {
      probe.style.color = '';
      probe.style.color = `var(${name})`;
      return toRgb(getComputedStyle(probe).color);
    };

    const themeVars = () => ({
      background: color('--bg'),
      primaryColor: color('--bg-subtle'),
      primaryTextColor: color('--text'),
      primaryBorderColor: color('--border'),
      lineColor: color('--text-muted'),
      secondaryColor: color('--accent-weak'),
      tertiaryColor: color('--bg-inset'),
      fontFamily:
        getComputedStyle(document.body).getPropertyValue('--font-mono').trim() || 'monospace',
      fontSize: '13px',
    });

    const sources = [...nodes].map((n) => n.textContent?.trim() ?? '');

    const { default: mermaid } = await import('mermaid');

    const render = async () => {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: isDark() ? 'dark' : 'base',
        themeVariables: themeVars(),
      });

      for (let i = 0; i < nodes.length; i++) {
        try {
          const { svg } = await mermaid.render(`mmd-${i}-${Date.now()}`, sources[i]);
          nodes[i].innerHTML = svg;
          nodes[i].dataset.rendered = '';
        } catch {
          // A broken diagram must not take the page down — leave the source as is.
          nodes[i].dataset.failed = '';
        }
      }
    };

    await render();

    // Redraw when the reader's system switches between light and dark.
    scheme.addEventListener('change', () => void render());
  }
</script>
