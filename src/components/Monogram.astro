---
import Icon from './Icon.astro';
import { resolveIcon } from '../lib/icons.mjs';

/**
 * A project's mark, in order of precedence: an image, a glyph from the shared
 * icon set, or one to three characters. Colours are passed in rather than
 * inherited, so the mark keeps its identity in a list of mixed projects.
 */
interface Props {
  monogram: string;
  accent: string;
  accentDark?: string;
  glyph?: string;
  icon?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { monogram, accent, accentDark, glyph, icon, size = 'md' } = Astro.props;
const style = `--brand-light:${accent};--brand-dark:${accentDark ?? accent};`;
const px = { sm: 18, md: 28, lg: 44 }[size];
const glyphPx = { sm: 11, md: 17, lg: 26 }[size];
const hasGlyph = Boolean(glyph && resolveIcon(glyph));
---

{
  icon ? (
    <img
      class:list={['monogram', 'monogram--icon', `monogram--${size}`]}
      src={icon}
      width={px}
      height={px}
      alt=""
      aria-hidden="true"
      style={style}
    />
  ) : hasGlyph ? (
    <span class:list={['monogram', 'monogram--glyph', `monogram--${size}`]} style={style} aria-hidden="true">
      <Icon name={glyph!} size={glyphPx} />
    </span>
  ) : (
    <span class:list={['monogram', `monogram--${size}`]} style={style} aria-hidden="true">
      {monogram}
    </span>
  )
}
