---
/**
 * The house mark — a K held inside a square.
 *
 * It inherits `currentColor`, so it takes the brand colour in the header and a
 * project's own accent wherever a project is being shown.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: klass } = Astro.props;
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <rect x="0.9" y="0.9" width="18.2" height="18.2" rx="4.4" stroke-width="1.5" />
  <path d="M7 5.4v9.2M13.4 5.6 8.4 9.8l5 4.6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>
