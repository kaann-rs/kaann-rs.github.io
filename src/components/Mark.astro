---
/**
 * The house mark — the cloud from the brand kit.
 *
 * Unlike the icon sets this one keeps its own colours: the mark is the one
 * place the full indigo ramp appears, so it stays itself on either surface.
 * The gradient is in user space, which is what lets the three overlapping
 * shapes read as a single silhouette instead of three seams.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: klass } = Astro.props;

/* One page can hold several marks — header, footer, an OG fallback — and a
   repeated gradient id would make every one of them use the first. */
const id = `mark-${Math.random().toString(36).slice(2, 9)}`;
const width = Math.round(size * (26 / 18));
---

<svg
  class:list={['brand-mark', klass]}
  width={width}
  height={size}
  viewBox="0 0 26 18"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={id} gradientUnits="userSpaceOnUse" x1="2" y1="1" x2="23" y2="18">
      <stop offset="0" stop-color="#A5B4FC" />
      <stop offset="0.35" stop-color="#6366F1" />
      <stop offset="0.75" stop-color="#4F46E5" />
      <stop offset="1" stop-color="#3730A3" />
    </linearGradient>
  </defs>

  <g fill={`url(#${id})`}>
    <circle cx="9.5" cy="7.2" r="5.6" />
    <circle cx="17" cy="9.8" r="6.6" />
    <rect x="2.4" y="9" width="20" height="8.6" rx="4.3" />
  </g>
</svg>
