---
import { render } from 'astro:content';

import Base from './Base.astro';
import TOC from '../components/TOC.astro';
import Sources from '../components/Sources.astro';
import Tag from '../components/Tag.astro';
import Comments from '../components/Comments.astro';
import { getTranslation, getNeighbours, readingTime, slugOf, type Post } from '../lib/posts';
import { t, base, formatDate } from '../i18n/ui';

interface Props { post: Post }

const { post } = Astro.props;
const lang = post.data.lang;
const tr_ = t(lang);
const b = base(lang);

const { Content, headings } = await render(post);
const translation = await getTranslation(post);
const { newer, older } = await getNeighbours(post);

const mins = readingTime(post.body ?? '');
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const showToc = post.data.toc && tocItems.length >= 2;

const altPath = translation
  ? `${base(translation.data.lang)}/posts/${slugOf(translation.id)}/`
  : undefined;
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  path={Astro.url.pathname}
  altPath={altPath}
>
  <div class="post-layout">
    <div class="wrap">
      <article>
        <header class="post-header">
          <div class="post-header__meta meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
            <span>·</span>
            <span>{mins} {tr_('post.readingTime')}</span>
            {
              post.data.updated && (
                <>
                  <span>·</span>
                  <span>{tr_('post.updated')} {formatDate(post.data.updated, lang)}</span>
                </>
              )
            }
          </div>

          <h1>{post.data.title}</h1>
          <p class="post-header__desc">{post.data.description}</p>

          {
            post.data.tags.length > 0 && (
              <ul class="tag-list" style="margin-top:1.25rem">
                {post.data.tags.map((tag) => (
                  <li>
                    <Tag tag={tag} href={`${b}/tags/${tag}/`} />
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        {
          showToc && (
            <details class="toc-inline">
              <summary>{tr_('post.toc')}</summary>
              <TOC headings={headings} label={tr_('post.toc')} />
            </details>
          )
        }

        <div class="prose">
          <Content />
        </div>

        <Sources sources={post.data.sources} label={tr_('post.sources')} />

        {
          (newer || older) && (
            <nav class="post-nav" aria-label={lang === 'tr' ? 'Yazılar arası gezinme' : 'Post navigation'}>
              <div>
                {older && (
                  <a href={`${b}/posts/${slugOf(older.id)}/`}>
                    <span class="post-nav__dir">← {lang === 'tr' ? 'Önceki' : 'Older'}</span>
                    {older.data.title}
                  </a>
                )}
              </div>
              <div class="post-nav__next">
                {newer && (
                  <a href={`${b}/posts/${slugOf(newer.id)}/`}>
                    <span class="post-nav__dir">{lang === 'tr' ? 'Sonraki' : 'Newer'} →</span>
                    {newer.data.title}
                  </a>
                )}
              </div>
            </nav>
          )
        }

        {post.data.comments && <Comments lang={lang} />}
      </article>
    </div>

    {
      showToc && (
        <aside class="toc-aside">
          <div class="toc-aside__sticky">
            <TOC headings={headings} label={tr_('post.toc')} />
          </div>
        </aside>
      )
    }
  </div>
</Base>
