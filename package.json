{
  "name": "blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "clean": "rm -rf dist .astro node_modules/.astro node_modules/.vite",
    "rebuild": "npm run clean && npm run build",
    "macros": "node scripts/mathjax-preamble.mjs",
    "new:project": "node scripts/new-project.mjs",
    "new:release": "node scripts/new-release.mjs",
    "new:doc": "node scripts/new-doc.mjs",
    "build:fast": "astro build",
    "new:cover": "node scripts/new-cover.mjs",
    "cms": "next dev cms --port 3001",
    "cms:types": "PAYLOAD_CONFIG_PATH=cms/payload.config.ts payload generate:types",
    "cms:importmap": "PAYLOAD_CONFIG_PATH=cms/payload.config.ts payload generate:importmap",
    "cms:import": "PAYLOAD_CONFIG_PATH=cms/payload.config.ts payload run cms/import-content.ts",
    "build:cms": "CONTENT_SOURCE=cms astro build && pagefind --site dist",
    "dev:cms": "CONTENT_SOURCE=cms astro dev",
    "cms:count": "PAYLOAD_CONFIG_PATH=cms/payload.config.ts payload run cms/count-content.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@shikijs/transformers": "^4.4.3",
    "astro": "^5.16.2",
    "katex": "^0.16.25",
    "mermaid": "^11.17.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.33.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/inter": "^5.3.0",
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "graphql": "^16.14.2",
    "gray-matter": "^4.0.3",
    "next": "^16.3.3",
    "pagefind": "^1.5.2",
    "payload": "^3.88.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3"
  }
}
